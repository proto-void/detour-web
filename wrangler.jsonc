{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "detour-web",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "detour.protovoid.com",
      "custom_domain": true
    }
  ]
}
