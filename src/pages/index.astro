---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../../site.config';
import { faqPageLd } from '../lib/seo';

const features = [
  {
    title: 'Redirect URL',
    body: 'Redirect requests so production scripts, APIs, or hosts load from localhost or another origin.',
    image: '/screenshots/redirect.webp',
    imagePng: '/screenshots/redirect.png',
    alt: 'Detour rules editor with a redirect from cdn.example.com to localhost:5173',
  },
  {
    title: 'Modify headers',
    body: 'Add, rewrite, or strip request and response headers on matched URLs.',
    image: '/screenshots/headers.webp',
    imagePng: '/screenshots/headers.png',
    alt: 'Detour modify-headers action editing request and response headers for api.example.com',
  },
  {
    title: 'Inject JS / CSS',
    body: 'Inject JavaScript or CSS on matched pages while you debug — no proxy appliance.',
    image: '/screenshots/inject.webp',
    imagePng: '/screenshots/inject.png',
    alt: 'Detour inject JavaScript rule editor with inline code for example.com',
  },
  {
    title: 'Mock fetch / XHR',
    body: 'Stub fetch and XHR responses in Chrome so you can override APIs without a mock server.',
    image: '/screenshots/mock.webp',
    imagePng: '/screenshots/mock.png',
    alt: 'Detour mock fetch editor stubbing GET api.example.com/v1/me with JSON',
  },
  {
    title: 'Replace response body',
    body: 'Swap response bodies locally after you allow body override (debugger on Chrome).',
    image: '/screenshots/body.webp',
    imagePng: '/screenshots/body.png',
    alt: 'Detour replace-body editor overriding cdn.example.com/config.json for local flags',
  },
] as const;

const faqs = [
  {
    question: 'Is Detour a Charles or Fiddler alternative?',
    answer:
      'Detour is a browser extension for redirecting and overriding requests in Chrome (and Edge/Firefox), not a system-wide MITM proxy. Use it when you want local redirect rules, header changes, mocks, and injects without installing a desktop proxy.',
  },
  {
    question: 'Is Detour a Resource Override alternative?',
    answer:
      'Yes — Detour is an MIT rewrite inspired by Resource Override, built for Manifest V3. See the honest comparison at /vs-resource-override/.',
  },
  {
    question: 'Does any of my data leave the device?',
    answer:
      'No Detour cloud and no account. Rules, mocks, and the match log stay in the browser. The product site may see standard CDN edge logs only.',
  },
  {
    question: 'Why does Chrome ask for the debugger permission?',
    answer:
      'Body replace on Chrome uses the debugger API because Manifest V3 has no other way to fulfill a response body in place. Detour only attaches after you click Allow debugger, and only for matching http(s) tabs.',
  },
  {
    question: 'Is Detour related to the Detour proxy add-on?',
    answer:
      'No. This Detour is a Protovoid developer tools extension (proto-void/detour). It is not a VPN or traffic proxy SaaS.',
  },
] as const;
---

<BaseLayout includeAppSchema={true} jsonLd={faqPageLd(faqs)}>
  <main>
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero__atmosphere" aria-hidden="true">
        <div class="hero__mesh"></div>
        <div class="hero__orb hero__orb--magenta"></div>
        <div class="hero__orb hero__orb--violet"></div>
        <div class="hero__grid"></div>
        <div class="hero__path"></div>
      </div>

      <div class="wrap hero__inner">
        <div class="hero__brand reveal">
          <img
            src="/brand/logo.svg"
            alt="Detour"
            width="220"
            height="48"
            class="hero__logo"
          />
        </div>
        <h1 id="hero-heading" class="hero__headline reveal reveal--delay-1">
          Redirect and override production requests in Chrome
        </h1>
        <p class="hero__lede reveal reveal--delay-2">
          {siteConfig.tagline} Free, MIT-licensed extension to redirect requests, modify headers,
          mock fetch/XHR, inject JS/CSS, and replace bodies — rules stay on your device. No account.
          No Detour server.
        </p>
        <div class="hero__cta reveal reveal--delay-3">
          <a class="btn btn--primary" href={siteConfig.github}>View on GitHub</a>
          {
            siteConfig.chromeStoreUrl ? (
              <a class="btn btn--ghost" href={siteConfig.chromeStoreUrl}>
                Get for Chrome
              </a>
            ) : (
              <span class="btn btn--muted" title="Chrome Web Store listing coming soon">
                Chrome soon
              </span>
            )
          }
        </div>
      </div>
    </section>

    <section class="see" id="see" aria-labelledby="see-heading">
      <div class="wrap">
        <header class="see__head reveal">
          <h2 id="see-heading">See it in Detour</h2>
          <p>
            The popup keeps Detour on, shows what applied on this tab, and opens Rules, API Tester, and
            the match log — without leaving the page you are debugging.
          </p>
        </header>
        <figure class="see__frame reveal reveal--delay-1">
          <picture>
            <source srcset="/screenshots/popup.webp" type="image/webp" />
            <img
              src="/screenshots/popup.png"
              alt="Detour extension popup in dark theme showing Applied status, Local overrides group, and links to Rules and Log"
              width="400"
              height="640"
              loading="eager"
              decoding="async"
            />
          </picture>
        </figure>
      </div>
    </section>

    <section class="features" id="features" aria-labelledby="features-heading">
      <div class="wrap">
        <header class="features__head reveal">
          <h2 id="features-heading">Local-only overrides</h2>
          <p>
            Everything runs in the browser. Redirect production to localhost, override responses, and
            choose when body replace is allowed.
          </p>
        </header>
        <ul class="features__list">
          {
            features.map((feature, i) => (
              <li
                class={`features__row reveal reveal--delay-${Math.min(i + 1, 3)} ${i % 2 === 1 ? 'features__row--flip' : ''}`}
              >
                <div class="features__copy">
                  <h3>{feature.title}</h3>
                  <p>{feature.body}</p>
                </div>
                <figure class="features__frame">
                  <picture>
                    <source srcset={feature.image} type="image/webp" />
                    <img
                      src={feature.imagePng}
                      alt={feature.alt}
                      width="1280"
                      height="900"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="faq" id="faq" aria-labelledby="faq-heading">
      <div class="wrap">
        <header class="faq__head reveal">
          <h2 id="faq-heading">FAQ</h2>
          <p>Short answers for developers comparing tools and permissions.</p>
        </header>
        <div class="faq__list">
          {
            faqs.map((faq, i) => (
              <details
                class={`faq__item reveal reveal--delay-${Math.min(i + 1, 3)}`}
                open={i === 0}
              >
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(100dvh, 52rem);
    display: grid;
    align-items: center;
    padding: clamp(4rem, 12vh, 7rem) 0 clamp(3rem, 8vh, 5rem);
    overflow: clip;
  }

  .hero__atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero__mesh {
    position: absolute;
    inset: -20% -10%;
    background:
      radial-gradient(ellipse 55% 45% at 18% 30%, var(--glow-magenta), transparent 70%),
      radial-gradient(ellipse 50% 40% at 82% 55%, var(--glow-blue), transparent 72%),
      radial-gradient(ellipse 40% 35% at 50% 80%, var(--glow-violet), transparent 70%);
    animation: mesh-drift 18s var(--ease) infinite alternate;
  }

  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(48px);
    opacity: 0.55;
  }

  .hero__orb--magenta {
    width: min(28rem, 70vw);
    height: min(28rem, 70vw);
    top: -8%;
    left: -12%;
    background: var(--glow-magenta);
    animation: orb-pulse 9s var(--ease) infinite alternate;
  }

  .hero__orb--violet {
    width: min(22rem, 55vw);
    height: min(22rem, 55vw);
    right: -8%;
    bottom: 8%;
    background: var(--glow-violet);
    animation: orb-pulse 11s var(--ease) infinite alternate-reverse;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.55), transparent 85%);
    opacity: 0.5;
  }

  .hero__path {
    position: absolute;
    inset: 18% 8% auto;
    height: 2px;
    background: var(--pv-gradient);
    opacity: 0.35;
    transform-origin: left center;
    animation: path-draw 1.4s var(--ease-out) both;
  }

  .hero__path::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 10px;
    height: 10px;
    border-right: 2px solid var(--accent);
    border-top: 2px solid var(--accent);
    transform: translateY(-50%) rotate(45deg);
  }

  .hero__inner {
    max-width: 40rem;
  }

  .hero__logo {
    width: min(13.75rem, 70vw);
    height: auto;
  }

  .hero__headline {
    margin: var(--space-5) 0 var(--space-4);
    font-size: var(--text-display);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    font-weight: 620;
  }

  .hero__lede {
    margin: 0 0 var(--space-6);
    max-width: 34rem;
    color: var(--text-2);
    font-size: var(--text-lg);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .see {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--border);
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg) 55%);
  }

  .see__head {
    margin-bottom: var(--space-6);
    max-width: 36rem;
  }

  .see__head h2 {
    margin: 0 0 var(--space-2);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    letter-spacing: -0.03em;
  }

  .see__head p {
    margin: 0;
    color: var(--text-2);
  }

  .see__frame {
    margin: 0;
    max-width: 26rem;
    border: 1px solid var(--border);
    background: var(--surface-2);
    overflow: clip;
  }

  .see__frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .features {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--border);
  }

  .features__head {
    margin-bottom: var(--space-7);
    max-width: 36rem;
  }

  .features__head h2 {
    margin: 0 0 var(--space-2);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    letter-spacing: -0.03em;
  }

  .features__head p {
    margin: 0;
    color: var(--text-2);
  }

  .features__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 6vh, 4rem);
  }

  .features__row {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  @media (min-width: 48rem) {
    .features__row {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-7);
    }

    .features__row--flip .features__copy {
      order: 2;
    }

    .features__row--flip .features__frame {
      order: 1;
    }
  }

  .features__copy h3 {
    margin: 0 0 var(--space-2);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .features__copy h3::before {
    content: '';
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    margin-right: 0.55rem;
    vertical-align: 0.05em;
    background: var(--pv-gradient);
  }

  .features__copy p {
    margin: 0;
    color: var(--text-2);
    font-size: var(--text-base);
    max-width: 28rem;
  }

  .features__frame {
    margin: 0;
    border: 1px solid var(--border);
    background: var(--surface-2);
    overflow: clip;
  }

  .features__frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .faq {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--border);
  }

  .faq__head {
    margin-bottom: var(--space-6);
    max-width: 36rem;
  }

  .faq__head h2 {
    margin: 0 0 var(--space-2);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    letter-spacing: -0.03em;
  }

  .faq__head p {
    margin: 0;
    color: var(--text-2);
  }

  .faq__list {
    display: grid;
    gap: var(--space-3);
    max-width: 40rem;
  }

  .faq__item {
    border-top: 1px solid var(--border);
    padding: var(--space-4) 0;
  }

  .faq__item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .faq__item summary {
    cursor: pointer;
    font-weight: 600;
    letter-spacing: -0.02em;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::after {
    content: '+';
    float: right;
    color: var(--accent);
    font-weight: 500;
  }

  .faq__item[open] summary::after {
    content: '−';
  }

  .faq__item p {
    margin: var(--space-3) 0 0;
    color: var(--text-2);
    font-size: var(--text-sm);
  }

  .reveal {
    opacity: 0;
    transform: translateY(0.85rem);
    animation: rise-in 700ms var(--ease-out) forwards;
  }

  .reveal--delay-1 {
    animation-delay: 100ms;
  }
  .reveal--delay-2 {
    animation-delay: 180ms;
  }
  .reveal--delay-3 {
    animation-delay: 260ms;
  }

  @keyframes rise-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes mesh-drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(2%, -1.5%, 0) scale(1.04);
    }
  }

  @keyframes orb-pulse {
    from {
      opacity: 0.4;
      transform: scale(1);
    }
    to {
      opacity: 0.7;
      transform: scale(1.08);
    }
  }

  @keyframes path-draw {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
    to {
      transform: scaleX(1);
      opacity: 0.35;
    }
  }
</style>
