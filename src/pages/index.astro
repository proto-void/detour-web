---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../../site.config';

const features = [
  {
    title: 'Redirect',
    body: 'Point production URLs at localhost or another origin.',
  },
  {
    title: 'Headers',
    body: 'Add, rewrite, or strip request and response headers.',
  },
  {
    title: 'Inject',
    body: 'Drop in JS or CSS on matched pages while you debug.',
  },
  {
    title: 'Mock',
    body: 'Stub fetch and XHR responses without a proxy appliance.',
  },
  {
    title: 'Body replace',
    body: 'Swap response bodies locally after you allow it.',
  },
] as const;
---

<BaseLayout>
  <main>
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero__atmosphere" aria-hidden="true">
        <div class="hero__mesh"></div>
        <div class="hero__orb hero__orb--magenta"></div>
        <div class="hero__orb hero__orb--violet"></div>
        <div class="hero__grid"></div>
        <div class="hero__path"></div>
      </div>

      <div class="wrap hero__inner">
        <div class="hero__brand reveal">
          <img
            src="/brand/logo.svg"
            alt="Detour"
            width="220"
            height="48"
            class="hero__logo"
          />
        </div>
        <h1 id="hero-heading" class="hero__headline reveal reveal--delay-1">
          {siteConfig.tagline}
        </h1>
        <p class="hero__lede reveal reveal--delay-2">
          Free, MIT-licensed browser extension. Redirect, rewrite, inject, mock, and replace —
          rules stay on your device. No account. No Detour server.
        </p>
        <div class="hero__cta reveal reveal--delay-3">
          <a class="btn btn--primary" href={siteConfig.github}>View on GitHub</a>
          {
            siteConfig.chromeStoreUrl ? (
              <a class="btn btn--ghost" href={siteConfig.chromeStoreUrl}>
                Get for Chrome
              </a>
            ) : (
              <span class="btn btn--muted" title="Chrome Web Store listing coming soon">
                Chrome soon
              </span>
            )
          }
        </div>
      </div>
    </section>

    <section class="features" aria-labelledby="features-heading">
      <div class="wrap">
        <header class="features__head reveal">
          <h2 id="features-heading">Local-only overrides</h2>
          <p>Everything runs in the browser. You choose when body override is allowed.</p>
        </header>
        <ul class="features__list">
          {
            features.map((feature, i) => (
              <li
                class={`features__item reveal reveal--delay-${Math.min(i + 1, 3)}`}
              >
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(100dvh, 52rem);
    display: grid;
    align-items: center;
    padding: clamp(4rem, 12vh, 7rem) 0 clamp(3rem, 8vh, 5rem);
    overflow: clip;
  }

  .hero__atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero__mesh {
    position: absolute;
    inset: -20% -10%;
    background:
      radial-gradient(ellipse 55% 45% at 18% 30%, var(--glow-magenta), transparent 70%),
      radial-gradient(ellipse 50% 40% at 82% 55%, var(--glow-blue), transparent 72%),
      radial-gradient(ellipse 40% 35% at 50% 80%, var(--glow-violet), transparent 70%);
    animation: mesh-drift 18s var(--ease) infinite alternate;
  }

  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(48px);
    opacity: 0.55;
  }

  .hero__orb--magenta {
    width: min(28rem, 70vw);
    height: min(28rem, 70vw);
    top: -8%;
    left: -12%;
    background: var(--glow-magenta);
    animation: orb-pulse 9s var(--ease) infinite alternate;
  }

  .hero__orb--violet {
    width: min(22rem, 55vw);
    height: min(22rem, 55vw);
    right: -8%;
    bottom: 8%;
    background: var(--glow-violet);
    animation: orb-pulse 11s var(--ease) infinite alternate-reverse;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.55), transparent 85%);
    opacity: 0.5;
  }

  .hero__path {
    position: absolute;
    inset: 18% 8% auto;
    height: 2px;
    background: var(--pv-gradient);
    opacity: 0.35;
    transform-origin: left center;
    animation: path-draw 1.4s var(--ease-out) both;
  }

  .hero__path::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 10px;
    height: 10px;
    border-right: 2px solid var(--accent);
    border-top: 2px solid var(--accent);
    transform: translateY(-50%) rotate(45deg);
  }

  .hero__inner {
    max-width: 40rem;
  }

  .hero__logo {
    width: min(13.75rem, 70vw);
    height: auto;
  }

  .hero__headline {
    margin: var(--space-5) 0 var(--space-4);
    font-size: var(--text-display);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    font-weight: 620;
  }

  .hero__lede {
    margin: 0 0 var(--space-6);
    max-width: 34rem;
    color: var(--text-2);
    font-size: var(--text-lg);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .features {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--border);
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%);
  }

  .features__head {
    margin-bottom: var(--space-6);
    max-width: 36rem;
  }

  .features__head h2 {
    margin: 0 0 var(--space-2);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    letter-spacing: -0.03em;
  }

  .features__head p {
    margin: 0;
    color: var(--text-2);
  }

  .features__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }

  .features__item h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .features__item h3::before {
    content: '';
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    margin-right: 0.55rem;
    vertical-align: 0.05em;
    background: var(--pv-gradient);
  }

  .features__item p {
    margin: 0;
    color: var(--text-2);
    font-size: var(--text-sm);
  }

  .reveal {
    opacity: 0;
    transform: translateY(0.85rem);
    animation: rise-in 700ms var(--ease-out) forwards;
  }

  .reveal--delay-1 {
    animation-delay: 100ms;
  }
  .reveal--delay-2 {
    animation-delay: 180ms;
  }
  .reveal--delay-3 {
    animation-delay: 260ms;
  }

  @keyframes rise-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes mesh-drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(2%, -1.5%, 0) scale(1.04);
    }
  }

  @keyframes orb-pulse {
    from {
      opacity: 0.4;
      transform: scale(1);
    }
    to {
      opacity: 0.7;
      transform: scale(1.08);
    }
  }

  @keyframes path-draw {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
    to {
      transform: scaleX(1);
      opacity: 0.35;
    }
  }
</style>
